{
  "name": "myst-parser-unified",
  "version": "0.0.1",
  "description": "A proof of concept for parsing MyST Markdown with micromark and unified",
  "scripts": {
    "test": "vitest run",
    "score": "node scripts/score.ts",
    "docs": "npm run score && cd docs && myst build --html",
    "docs:live": "npm run score && cd docs && myst start",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "corpus": "node scripts/corpus.ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./mystmd": {
      "types": "./dist/mystParse.d.ts",
      "default": "./dist/mystParse.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "license": "BSD-3-Clause",
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3"
  },
  "peerDependencies": {
    "myst-parser": "1.7.4"
  },
  "peerDependenciesMeta": {
    "myst-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "js-yaml": "^5.4.2",
    "myst-ext-button": "^0.0.2",
    "myst-ext-card": "^1.0.9",
    "myst-ext-exercise": "^1.0.10",
    "myst-ext-grid": "^1.1.1",
    "myst-ext-proof": "^1.0.13",
    "myst-ext-tabs": "^1.0.10",
    "myst-parser": "1.7.4",
    "myst-spec": "^0.0.6",
    "mystmd": "^1.11.0",
    "remark-parse": "^11.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
