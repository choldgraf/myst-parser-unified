{
  "name": "myst-parser-unified",
  "description": "A proof of concept for parsing MyST Markdown with micromark and unified",
  "scripts": {
    "test": "vitest run",
    "score": "node scripts/score.ts",
    "docs": "npm run score && cd docs && myst build --html",
    "docs:live": "npm run score && cd docs && myst start",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "exports": {
    ".": "./src/parse.ts",
    "./roles": "./src/roles.ts",
    "./directives": "./src/directives.ts",
    "./blocks": "./src/blocks.ts"
  },
  "private": true,
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "js-yaml": "^5.4.2",
    "micromark-util-types": "^2.0.3",
    "myst-parser": "^1.7.4",
    "myst-spec": "^0.0.6",
    "mystmd": "^1.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
